<Window x:Class="GI_Subtitles.Views.ActivityLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GI_Subtitles.Views"
        Title="{DynamicResource ActivityLog_Title}"
        Width="720"
        Height="480"
        MinWidth="480"
        MinHeight="280"
        Icon="../Resources/mask.ico"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="False"
        ResizeMode="CanResize"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <ContextMenu x:Key="LogCopyMenu" Opened="CopyMenu_Opened">
            <MenuItem Header="{DynamicResource ActivityLog_Copy}" Click="CopyMenuItem_Click"/>
        </ContextMenu>
        <Style x:Key="LogCellTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="ContextMenu" Value="{StaticResource LogCopyMenu}"/>
            <!-- The TextBox theme Foreground outranks inheritance; mirror the
                 row's so the cells follow the row's effective Foreground. -->
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"/>
            <!-- Default TextBox templates wrap PART_ContentHost in a ScrollViewer.
                 Under a pixel-virtualized GridView that costs one inner scroller
                 per cell (~4 per row) on every recycle/measure. Cells scroll with
                 the list, so a Decorator host keeps selection without that tree. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Decorator x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The result cell's selection layer (ADR 0012): transparent glyphs
             over the colored TextBlock, so selection, copy-on-select, and
             Ctrl+C still read the full text while the color comes from the
             layer underneath. Everything except the Foreground must match
             the colored layer exactly, or the selection rectangles drift off
             the visible glyphs; the caret is invisible by design. -->
        <Style x:Key="LogResultSelectionTextBox" TargetType="TextBox" BasedOn="{StaticResource LogCellTextBox}">
            <Setter Property="Foreground" Value="Transparent"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
        </Style>
    </Window.Resources>
    <Grid>
        <ListView x:Name="LogList"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  ContextMenu="{StaticResource LogCopyMenu}"
                  PreviewMouseLeftButtonUp="LogList_PreviewMouseLeftButtonUp">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="RowItem_PreviewMouseLeftButtonDown"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRepeat}" Value="True">
                            <!-- Whole-row dimming so the colored layer, the
                                 transparent selection layer, and the default
                                 text fade together (ADR 0012); a gray
                                 Foreground would leave the colored tags at
                                 full strength. -->
                            <Setter Property="Opacity" Value="0.55"/>
                            <Setter Property="FontStyle" Value="Italic"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{DynamicResource ActivityLog_Column_Time}" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource LogCellTextBox}" Text="{Binding Time, Mode=OneWay}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource ActivityLog_Column_RegionPair}" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource LogCellTextBox}" Text="{Binding RegionPair, Mode=OneWay}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource ActivityLog_Column_Job}" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource LogCellTextBox}" Text="{Binding Job, Mode=OneWay}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource ActivityLog_Column_Result}" Width="280">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Two layers of the same text (ADR 0012): the
                                     colored TextBlock renders the tagged runs,
                                     the transparent TextBox on top keeps the
                                     native selection. Both wrap and inherit
                                     font, padding, and size from the row, so
                                     they stay glyph-aligned; if a sub-pixel
                                     inset ever shows at high DPI, calibrate it
                                     here with a one-time Margin. -->
                                <Grid>
                                    <local:ActivityLogResultTextBlock Lines="{Binding ResultLines, Mode=OneWay}"
                                                                      TextWrapping="Wrap"
                                                                      Padding="0"
                                                                      IsHitTestVisible="False"/>
                                    <TextBox Style="{StaticResource LogResultSelectionTextBox}"
                                             Text="{Binding Result, Mode=OneWay}"
                                             TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock x:Name="EmptyState"
                   Text="{DynamicResource ActivityLog_Empty}"
                   Margin="16,36,16,0"
                   TextWrapping="Wrap"
                   Foreground="#555555"
                   VerticalAlignment="Top"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
